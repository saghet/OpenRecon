# OpenRecon 3.0 Docker Compose Production Template
# Copy to .env before running `docker compose up -d --build`

POSTGRES_USER=openrecon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=openrecon

SECRET_KEY=CHANGE_ME_RANDOM_64_HEX_SECRET
OPENRECON_API_TOKEN=CHANGE_ME_API_BEARER_TOKEN
OPENRECON_MASTER_KEY=CHANGE_ME_FERNET_OR_32BYTE_KEY

SAFE_MODE=true
RATE_LIMIT_RPS=15
MAX_CONCURRENT_TASKS=5

# Optional CTI / AI Integrations
OPENCTI_URL=
OPENCTI_TOKEN=
MISP_URL=
MISP_KEY=
DEEPSEEK_API_KEY=

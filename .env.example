# OpenRecon Environment Configuration
PROJECT_NAME="OpenRecon"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_secure_random_key_in_production"
OPENRECON_MASTER_KEY=""
OPENRECON_API_TOKEN=""

# CORS & TLS Configuration
CORS_ALLOWED_ORIGINS='["http://localhost","http://127.0.0.1","http://localhost:8000"]'
CUSTOM_CA_BUNDLE=""

# Database Configuration (PostgreSQL for production, SQLite only for isolated dev/tests)
DATABASE_URL="postgresql://openrecon:openrecon_password@localhost:5432/openrecon"

# Redis / Queue Broker (Required for distributed Kill-Switch and worker coordination)
REDIS_URL="redis://localhost:6379/0"

# Scanner Safety Rules
MAX_CONCURRENT_TASKS=5
RATE_LIMIT_RPS=15
SAFE_MODE=true
ENABLE_EXTERNAL_BINARIES=true

# External CTI & AI Keys (Never commit real keys)
OPENCTI_URL=""
OPENCTI_TOKEN=""
MISP_URL=""
MISP_KEY=""
DEEPSEEK_API_KEY=""

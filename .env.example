# OpenRecon Environment Configuration
PROJECT_NAME="OpenRecon"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_secure_random_key_in_production"

# Database Configuration (Default SQLite for instant local dev, or PostgreSQL for production)
# SQLite example: sqlite:///./openrecon.db
# PostgreSQL example: postgresql://openrecon:openrecon@localhost:5432/openrecon
DATABASE_URL="sqlite:///./openrecon.db"

# Redis / Queue Broker (Optional for local dev, used in Docker/production)
REDIS_URL="redis://localhost:6379/0"

# Scanner Safety Rules
MAX_CONCURRENT_TASKS=5
RATE_LIMIT_RPS=15
SAFE_MODE=true
ENABLE_EXTERNAL_BINARIES=true
